# Copy this file to .env for local development, or set this same
# variable in Netlify's site settings for production.
#
# Local dev (talking to your laptop's backend on port 5001):
VITE_API_BASE_URL=http://localhost:5001

# Production (talking to your deployed Render backend) — use this
# value instead when setting the environment variable on Netlify:
# VITE_API_BASE_URL=https://swasthyasetu-ltng.onrender.com
